# Sent only as the X-Api-Key header. Never printed. At least 8 characters.
EXAMPLE_API_KEY=

# Upstream origin, optional path, no userinfo, query, or hash.
EXAMPLE_BASE_URL=https://example.invalid

# Contact embedded in the User-Agent. Must not be the API key.
EXAMPLE_CONTACT=you@example.com

# Local sliding window. Cache hits do not spend it.
EXAMPLE_PER_MINUTE=30

# Cache TTL in seconds. 0 disables caching.
EXAMPLE_CACHE_TTL_SEC=60

# Upstream timeout in milliseconds.
EXAMPLE_TIMEOUT_MS=20000

# stdio (default) or http. --http on the command line forces http.
MCP_TRANSPORT=stdio
PORT=3000
